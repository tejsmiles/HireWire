            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Workday RaaS: changed workers": {
      "main": [
        [
          {
            "node": "One item per worker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per worker": {
      "main": [
        [
          {
            "node": "Build envelope",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build envelope": {
      "main": [
