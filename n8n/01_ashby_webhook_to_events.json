        0
      ],
      "webhookId": "22c2dc49-d3ac-4ac2-ac85-968a0c770871"
    },
    {
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "value": "={{ JSON.stringify($json.body) }}",
        "dataPropertyName": "contentHash",
        "encoding": "hex"
      },
      "id": "964a035d-5a78-5edc-b832-9d95b12a3399",
      "name": "Content hash (dedupe id)",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Map an Ashby webhook to the onboard-sync envelope. Identical re-deliveries hash the same,\n// so the engine's event_id dedupe makes Ashby's retries harmless.\nconst b = $json.body;\nconst types = { offerAccepted: 'offer.accepted', offerUpdate: 'offer.updated', candidateUpdate: 'candidate.updated',\n                offerRescinded: 'offer.rescinded', candidateWithdrew: 'candidate.withdrew' };\nconst envelope = {\n  event_id: `ashby:${$json.contentHash.slice(0, 24)}`,\n  source: 'ashby',\n  type: types[b.action] ?? 'candidate.updated',\n  external_id: b.data?.candidate?.id,\n  occurred_at: b.data?.updatedAt ?? new Date().toISOString(),\n  payload: b,\n};\nif (!envelope.external_id) throw new Error('Ashby payload without candidate id');\nreturn [{ json: { body: JSON.stringify(envelope) } }];"
      },
      "id": "f94501e2-cbca-5aaa-844a-6c22cd57e7cb",
      "name": "Build envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.body }}",
        "dataPropertyName": "signature",
        "secret": "={{ $env.ONBOARD_SYNC_HMAC_SECRET }}",
        "encoding": "hex"
      },
      "id": "cebe67e2-dd4a-512a-8333-28e0d5cad309",
      "name": "HMAC sign body",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ONBOARD_SYNC_URL }}/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "79f256e6-dae7-5347-9604-298dfae1ad5e",
      "name": "POST /events",
